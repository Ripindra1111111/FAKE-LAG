<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="FAKE LAG TOOL"
            android:textColor="#B0B4C0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="VpnService · UDP drop 50–250B"
            android:textColor="#6C7086"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvVpnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="VPN: OFF"
            android:textColor="#6C7086"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="14dp"
            android:background="#6C7086"
            android:text="FAKE LAG: OFF"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDropCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="Đã drop: 0 gói"
            android:textColor="#B0B4C0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantVpn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="#313244"
            android:text="Cấp quyền VPN"
            android:textAllCaps="false"
            android:textColor="#CDD6F4"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Min byte:"
                android:textColor="#B0B4C0"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#313244"
                android:hint="50"
                android:inputType="number"
                android:paddingStart="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6C7086" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:text="Max:"
                android:textColor="#B0B4C0"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMax"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#313244"
                android:hint="250"
                android:inputType="number"
                android:paddingStart="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6C7086" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Log (5 dòng gần nhất)"
            android:textColor="#6C7086"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#181825"
            android:fontFamily="monospace"
            android:minHeight="100dp"
            android:padding="8dp"
            android:text=""
            android:textColor="#CDD6F4"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
